patch=0,EE,00453E5C,word,3C06004E
patch=0,EE,00453E60,word,0805467E
patch=0,EE,00453E64,word,00000000
// Fix 2: right after the previewer world is created (hook 0x151CEC), set the scene-tree root
// bounds to (0,0,0) size 1024 and set the tree's "built" flag (tree+0x78) so new objects are
// inserted into the tree instead of waiting forever in its pending list (tree+0x74). Code at 0x000FFF00.
patch=1,EE,000FFF00,word,AE02002C
