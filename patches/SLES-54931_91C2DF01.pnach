patch=1,EE,000FFF24,word,A10A0078
patch=0,EE,00151CEC,word,0C03FFC0
// Fix 3: create the light as type 2 (point) instead of 3 (spot), intensity 3.0.
patch=0,EE,00151ECC,word,34040002
patch=0,EE,00151EEC,word,3C044040

