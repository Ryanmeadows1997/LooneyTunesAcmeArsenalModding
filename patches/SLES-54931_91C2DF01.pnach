gametitle=Looney Tunes - ACME Arsenal (PAL-M) [SLES-54931] CRC 91C2DF01

// Acme Arsenal dev content patches by Glitch_Me_Up.
// Only enable ONE "Boot:" patch at a time.
// Both swap the BootSequence name the game looks up in GAMEDATA\BOOT\BOOT.XML
// ("LooneyTunes Release", stored at 0x004DF348) for one of the unused sequences.

[Boot: Development (skip straight to Hub)]
author=Glitch_Me_Up
description=Boots the unused "LooneyTunes Development" sequence: no splash screens or main menu, loads directly into the Hub.
