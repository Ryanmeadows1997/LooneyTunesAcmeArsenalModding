[Boot: Character Previewer (restored)]
author=Glitch_Me_Up
description=Boots the unused developer Character Previewer and fixes the three retail bugs that broke it: (1) waits for DDF_PAK.PAK before listing actors, (2) marks the previewer's scene tree as built so characters are actually drawn, (3) uses a point light (type 2) because the PS2 renderer ignores the spotlight it was given. Up/Down to choose, Cross to select, Triangle to go back.
// String swap: "LooneyTunes Release" -> "Character Previewer"
patch=1,EE,004DF348,word,72616843
patch=1,EE,004DF34C,word,65746361
patch=1,EE,004DF350,word,72502072
patch=1,EE,004DF354,word,65697665
patch=1,EE,004DF358,word,00726577
patch=1,EE,004DF35C,word,00000000
// Fix 1: wait for DDF_PAK.PAK to load before building the actor list.
// Hook 0x151964 -> code cave in unused padding at 0x453E20; polls kDDFSystem (vtable +0x20), max 8M tries.
patch=0,EE,00151964,word,08114F88
patch=0,EE,00453E20,word,1040000F
patch=0,EE,00453E24,word,3C110080
patch=0,EE,00453E28,word,0C0E9BEF
